{
  "model": {
    "name": "CompanyCreationEnriched",
    "label": {"en_US": "[Companies] Create a company (GLEIF / Sirene enrichment)", "fr_FR": "[Sociétés] Créer une société (enrichissement GLEIF / Sirene)"},
    "description": {"en_US": "Creation of a company in a child dataspace, automatic enrichment from GLEIF (LEI) and Sirene (INSEE), validation by a steward, merge.", "fr_FR": "Création d'une société dans un espace de travail enfant, enrichissement automatique depuis GLEIF (LEI) et Sirene (INSEE), validation par un steward, fusion."},
    "owner": "Badministrator",
    "launching": {"quick": false, "synchronous": false},
    "permissionsOnInstances": {"agentAccessForAdmin": "Badministrator", "agentAccessForInbox": "Badministrator", "creatorIsViewer": true},
    "notificationProcessTermination": {"notifyProcessCreator": true},
    "modelOrientation": 90,
    "startNodeId": 1
  },
  "dataContext": {"variables": [
    {"name": "workDataspace", "direction": "inout"},
    {"name": "companyXPath", "direction": "inout"},
    {"name": "enrichmentReport", "defaultValue": "", "direction": "inout"}
  ]},
  "nodes": [
    {"nodeId": 1, "kind": "scriptTask", "label": "Créer l'espace de travail", "description": "Espace de données enfant de Companies dans lequel la société est saisie, enrichie puis validée.", "firstInProcess": true,
     "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskCreateBranchI18n", "scriptMode": "library", "scriptLibrary": true,
     "beanParams": [{"name": "initialBranch", "value": "Companies"}, {"name": "label", "value": "Création de société"}, {"name": "description", "value": "Espace de travail d'une demande de création de société."}, {"name": "copyPermissionsFromParent", "value": "true"}, {"name": "ensureBranchClosingOnWorkflowTermination", "value": "true"}],
     "outputMappingParams": [{"name": "newHome", "value": "workDataspace"}]},
    {"nodeId": 2, "kind": "userTask", "label": "Saisir la société", "description": "Saisir le nom et, si possible, le LEI ou le SIREN : l'étape suivante complète le reste automatiquement.", "userTaskVersion": 2,
     "agentAccess": "allowed", "agentGuidance": "askHuman", "agentInstruction": "Créer un enregistrement dans /root/Companies avec au minimum Identification/Name, et Identification/LegalEntityIdentifier (LEI) ou le numéro SIREN quand ils sont connus.",
     "serviceDeclarationKey": "ebx-root-1.0@creation", "profiles": ["RUser"], "offeredToProfiles": ["RUser"],
     "input": {"parameters": [{"name": "service", "value": "@creation"}, {"name": "branch", "value": "${workDataspace}"}, {"name": "instance", "value": "Companies"}, {"name": "xpath", "value": "/root/Companies"}]},
     "output": {"parameters": [{"name": "companyXPath", "value": "created"}]},
     "enableReject": false, "enableConfirmationRequest": true, "enableComment": true,
     "termination": {"completionStrategy": "allWorkItemsCompleted", "rejectionThreshold": 0}},
    {"nodeId": 3, "kind": "scriptTask", "label": "Enrichir depuis GLEIF et Sirene", "description": "Étape automatique : informations légales, identifiants, adresses, maisons mères et score de complétude.",
     "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskExecuteScript", "scriptMode": "script",
     "scriptModePublicationName": "Fasttrack.companies.enrichCompany",
     "scriptModeParams": [{"name": "workDataspace", "value": "${workDataspace}"}, {"name": "companyXPath", "value": "${companyXPath}"}],
     "scriptModeOutputMappingParams": [{"name": "enrichmentReport", "value": "enrichmentReport"}]},
    {"nodeId": 4, "kind": "userTask", "label": "Valider la société enrichie", "description": "Steward : contrôler la fiche complétée automatiquement. ${enrichmentReport}", "userTaskVersion": 2,
     "agentAccess": "allowed", "agentGuidance": "askHuman",
     "serviceDeclarationKey": "ebx-root-1.0@default", "profiles": ["RSteward"], "offeredToProfiles": ["RSteward"],
     "input": {"parameters": [{"name": "service", "value": "@default"}, {"name": "branch", "value": "${workDataspace}"}, {"name": "instance", "value": "Companies"}, {"name": "xpath", "value": "${companyXPath}"}, {"name": "firstCallDisplay", "value": "record"}]},
     "enableReject": true, "enableConfirmationRequest": true, "enableComment": true,
     "customizedAcceptLabel": {"en_US": "Approve", "fr_FR": "Approuver"}, "customizedRejectLabel": {"en_US": "Send back for correction", "fr_FR": "Renvoyer pour correction"},
     "termination": {"completionStrategy": "allWorkItemsCompleted", "rejectionThreshold": 0}},
    {"nodeId": 5, "kind": "condition", "label": "Société approuvée ?", "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ConditionIsLastUserTaskAccepted", "conditionLibrary": true},
    {"nodeId": 6, "kind": "scriptTask", "label": "Fusionner dans Companies", "description": "La société entre dans le référentiel.",
     "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskMergeBranch", "scriptMode": "library", "scriptLibrary": true,
     "beanParams": [{"name": "branchName", "value": "${workDataspace}"}]},
    {"nodeId": 7, "kind": "userTask", "label": "Corriger la société", "description": "Le créateur corrige la fiche puis la renvoie en validation (nouvel enrichissement), ou annule la création.", "userTaskVersion": 2,
     "agentAccess": "allowed", "agentGuidance": "askHuman",
     "serviceDeclarationKey": "ebx-root-1.0@default", "profiles": ["RUser"], "offeredToProfiles": ["RUser"], "previousUserTaskIdReferenceForAllocation": "2",
     "input": {"parameters": [{"name": "service", "value": "@default"}, {"name": "branch", "value": "${workDataspace}"}, {"name": "instance", "value": "Companies"}, {"name": "xpath", "value": "${companyXPath}"}, {"name": "firstCallDisplay", "value": "record"}]},
     "enableReject": true, "enableConfirmationRequest": true, "enableComment": true,
     "customizedAcceptLabel": {"en_US": "Resubmit for validation", "fr_FR": "Renvoyer en validation"}, "customizedRejectLabel": {"en_US": "Cancel the creation", "fr_FR": "Annuler la création"},
     "termination": {"completionStrategy": "allWorkItemsCompleted", "rejectionThreshold": 0}},
    {"nodeId": 8, "kind": "condition", "label": "Renvoyée en validation ?", "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ConditionIsLastUserTaskAccepted", "conditionLibrary": true},
    {"nodeId": 9, "kind": "scriptTask", "label": "Annuler la création", "description": "Ferme l'espace de travail sans rien verser dans Companies.",
     "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskCloseBranch", "scriptMode": "library", "scriptLibrary": true,
     "beanParams": [{"name": "branchName", "value": "${workDataspace}"}]}
  ],
  "links": [
    {"fromNodeId": 1, "toNodeId": 2, "role": "default"},
    {"fromNodeId": 2, "toNodeId": 3, "role": "default"},
    {"fromNodeId": 3, "toNodeId": 4, "role": "default"},
    {"fromNodeId": 4, "toNodeId": 5, "role": "default"},
    {"fromNodeId": 5, "toNodeId": 6, "role": "ifTrue"},
    {"fromNodeId": 5, "toNodeId": 7, "role": "ifFalse"},
    {"fromNodeId": 7, "toNodeId": 8, "role": "default"},
    {"fromNodeId": 8, "toNodeId": 3, "role": "ifTrue"},
    {"fromNodeId": 8, "toNodeId": 9, "role": "ifFalse"}
  ]
}
