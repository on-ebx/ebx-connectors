                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="FieldProvenance" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Field provenance</osd:label>
                            <osd:description>Who wrote each field of a record and with which trust; read by the TRUSTED policy, kept as an audit trail.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Provenance des champs</osd:label>
                            <osd:description>Qui a écrit chaque champ d'un enregistrement et avec quelle confiance ; lu par la politique TRUSTED, conservé comme piste d'audit.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <!-- volume lot 5 (2026-09-28): primary key changed from the auto-increment id to
                                     the natural key so a look-up can go straight to lookupAdaptationByPrimaryKey
                                     instead of an O(rows x fields) XPath scan. See docs/REFERENCE.md and
                                     ConnectorRepository.provenanceOf/recordProvenance/fieldProvenanceKey. -->
                                <primaryKeys>/dataspace /dataset /tablePath /recordKey /fieldPath </primaryKeys>
                                <defaultLabel>${./fieldPath} = ${./value} (${./connector}, ${./trust})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="dataspace" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Espace de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataset" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jeu de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé de l'enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="fieldPath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Field</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="connector" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Written by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Écrit par</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Connector</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mapping" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Mapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="trust" type="xs:int" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trust of the source</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance de la source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="value" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Value written</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeur écrite</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="writtenAt" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Written at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Écrit le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="source" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Read from</osd:label>
                                        <osd:description>Where the value was read when the source says so: the document, its page and the words that state it (document feed).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lu dans</osd:label>
                                        <osd:description>Où la valeur a été lue quand la source le dit : le document, sa page et les mots qui l'énoncent (flux de documents).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Conflict" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Conflicts</osd:label>
                            <osd:description>A less trusted source proposed a different value for a field written by a more trusted one (TRUSTED policy): the proposal is kept here for a steward to decide.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Conflits</osd:label>
                            <osd:description>Une source moins fiable a proposé une autre valeur pour un champ écrit par une source plus fiable (politique TRUSTED) : la proposition est gardée ici pour qu'un steward tranche.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./fieldPath}: ${./currentValue} vs ${./proposedValue} (${./proposedConnector})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="status" minOccurs="0" maxOccurs="1" default="OPEN">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="OPEN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Open</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Ouvert</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLYING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Being accepted (the acceptance did not finish: accept or reject it again)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En cours d'acceptation (l'acceptation n'est pas allée au bout : l'accepter ou la rejeter à nouveau)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted (proposed value applied by hand)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté (valeur proposée appliquée à la main)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected (current value kept)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Rejeté (valeur en place conservée)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Espace de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataset" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jeu de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé de l'enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordLabel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="fieldPath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Field</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="currentValue" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Current value</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeur en place</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="currentConnector" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Current value written by</osd:label>
                                        <osd:description>Empty: entered by hand or loaded outside the connectors (trust 100).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeur en place écrite par</osd:label>
                                        <osd:description>Vide : saisie à la main ou chargée hors connecteurs (confiance 100).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="currentTrust" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trust of the current value</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance de la valeur en place</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="proposedValue" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Proposed value</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeur proposée</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="proposedConnector" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Proposed by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Proposée par</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Connector</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="proposedTrust" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trust of the proposal</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance de la proposition</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mapping" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Mapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="detectedAt" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Detected at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détecté le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="comment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Steward comment</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire du steward</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="resolvedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Resolved by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Résolu par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="resolvedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Resolved at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Résolu le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ConnectorOperationalMetrics" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Connector health and metrics</osd:label><osd:description>Durable health, traffic, latency, checkpoint and schema-drift telemetry. Java 64-bit counters are stored as EBX-compatible decimal strings.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Santé et métriques des connecteurs</osd:label><osd:description>Télémétrie durable de santé, trafic, latence, point de reprise et dérive de schéma.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/connector </primaryKeys><recordForm osd:class="com.on.ebx.connect.ebx.ui.ConnectorMetricsForm"/><defaultLabel>${./connector}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="connector" type="xs:string" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Connector</osd:label><osd:description>Connector described by these figures (one row per connector).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Connecteur</osd:label><osd:description>Connecteur décrit par ces chiffres (une ligne par connecteur).</osd:description></xs:documentation>
                                <xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Connector</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="readCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Inbound records</osd:label><osd:description>Records read from the external application (inbound mappings and import feeds). A batch of a feed run counts every record it handled, not one per log line.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Enregistrements entrants</osd:label><osd:description>Enregistrements lus depuis l’application externe (mappings entrants et flux d’import). Un lot d’un flux compte chaque enregistrement traité, pas une ligne de journal.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="writeCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Outbound records</osd:label><osd:description>Records sent to the external application (outbound mappings).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Enregistrements sortants</osd:label><osd:description>Enregistrements envoyés à l’application externe (mappings sortants).</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="skipCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Records without change</osd:label><osd:description>Records that ended skipped, with no change or with no data returned.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Enregistrements sans changement</osd:label><osd:description>Enregistrements ignorés, sans modification ou sans donnée renvoyée.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="conflictCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Conflicts raised</osd:label><osd:description>Field conflicts opened by the trust policy (a value proposed by a less trusted source).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Conflits levés</osd:label><osd:description>Conflits de champ ouverts par la politique de confiance (valeur proposée par une source moins fiable).</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="requestCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Records processed</osd:label><osd:description>All records (or calls) of the connector, successful or not.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Enregistrements traités</osd:label><osd:description>Tous les enregistrements (ou appels) du connecteur, réussis ou non.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="retryCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Retries</osd:label><osd:description>Calls retried after a transient error. Reserved: not fed by the current runtime.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Nouvelles tentatives</osd:label><osd:description>Appels relancés après une erreur passagère. Réservé : pas encore alimenté.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="throttleCount" type="metricCounter" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Throttled calls</osd:label><osd:description>Calls refused by the external service for rate limiting. Reserved: not fed by the current runtime.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Appels limités</osd:label><osd:description>Appels refusés par le service externe pour limitation de débit. Réservé : pas encore alimenté.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="durationSamples" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Durations (ms)</osd:label><osd:description>Duration in milliseconds of the last 256 executions, oldest first, comma-separated. Source of the latency percentiles.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Durées (ms)</osd:label><osd:description>Durée en millisecondes des 256 dernières exécutions, de la plus ancienne à la plus récente, séparées par des virgules. Sert au calcul des percentiles de latence.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="8192"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="lastSuccessAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last success</osd:label></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernier succès</osd:label></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="lastFailureAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last failure</osd:label></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernier échec</osd:label></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="lastFailure" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last error message</osd:label><osd:description>Message of the last failed execution, secrets masked.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernier message d’erreur</osd:label><osd:description>Message de la dernière exécution en échec, secrets masqués.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="consecutiveFailures" type="xs:int" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Consecutive failures</osd:label><osd:description>Reset to 0 by a success. 1 or more: degraded; 3 or more: failed.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Échecs consécutifs</osd:label><osd:description>Remis à 0 par un succès. 1 ou plus : dégradé ; 3 ou plus : en échec.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="checkpointAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last checkpoint</osd:label><osd:description>When an incremental synchronization last saved its checkpoint.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernier point de reprise</osd:label><osd:description>Dernier enregistrement d’un point de reprise par une synchronisation incrémentale.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="schemaDriftAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last schema drift</osd:label><osd:description>When the external service last returned a structure different from the expected one.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernière dérive de schéma</osd:label><osd:description>Dernière fois que le service externe a renvoyé une structure différente de celle attendue.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="schemaDriftCount" type="xs:int" minOccurs="0" maxOccurs="1" default="0">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Schema drifts</osd:label></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dérives de schéma</osd:label></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Updated</osd:label></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Mis à jour le</osd:label></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ConnectorGovernance" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Connector governance</osd:label><osd:description>Ownership, source precedence, approval, effective dates, publication version, dependencies and secret references.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Gouvernance des connecteurs</osd:label><osd:description>Propriété, priorité de source, approbation, dates d'effet, version, dépendances et références de secrets.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/resourceId </primaryKeys><defaultLabel>${./resourceId}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="resourceId" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="owner" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="sourceSystem" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="160"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="sourcePrecedence" type="xs:int" minOccurs="0" maxOccurs="1" default="0"/>
                        <xs:element name="approval" minOccurs="1" maxOccurs="1" default="DRAFT"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="DRAFT"/><xs:enumeration value="PENDING"/><xs:enumeration value="APPROVED"/><xs:enumeration value="REJECTED"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="effectiveFrom" type="xs:dateTime" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="effectiveUntil" type="xs:dateTime" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="publicationVersion" type="xs:int" minOccurs="0" maxOccurs="1" default="0"/>
                        <xs:element name="dependencies" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="secretReferences" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ConnectorGovernanceAudit" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Connector governance audit</osd:label><osd:description>Append-only, secret-safe governance transitions.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Audit de gouvernance des connecteurs</osd:label><osd:description>Transitions de gouvernance ajoutées au journal sans secrets.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/id </primaryKeys><defaultLabel>${./resourceId} ${./action}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="id" type="id" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="resourceId" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="action" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="80"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="actor" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="detail" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="4000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="occurredAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"/>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ExecutionRun" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Execution runs</osd:label><osd:description>Durable restart, item-attempt, dead-letter and lease state for bounded connector executions.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Exécutions</osd:label><osd:description>État durable de reprise, tentatives, rejets et verrous des exécutions bornées.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="it-IT"><osd:label>Esecuzioni</osd:label><osd:description>Stato persistente di ripresa, tentativi per elemento, scarti e lock delle esecuzioni limitate dei connettori.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/runId </primaryKeys><recordForm osd:class="com.on.ebx.connect.ebx.ui.ExecutionRunForm"/><defaultLabel>${./runId}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="runId" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Run ID</osd:label><osd:description>Identifier of the execution; a restarted run resumes from the state stored under the same identifier.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Identifiant d'exécution</osd:label><osd:description>Identifiant de l'exécution ; une exécution relancée reprend l'état enregistré sous le même identifiant.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>ID esecuzione</osd:label><osd:description>Identificativo dell'esecuzione; un'esecuzione riavviata riprende lo stato salvato con lo stesso identificativo.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="160"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="nextIndex" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Next item index</osd:label><osd:description>Position of the next item to process: a restart continues from here instead of starting over.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Index du prochain élément</osd:label><osd:description>Position du prochain élément à traiter : une reprise continue à partir d'ici au lieu de tout recommencer.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Indice del prossimo elemento</osd:label><osd:description>Posizione del prossimo elemento da elaborare: una ripresa continua da qui invece di ricominciare da capo.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="attempts" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Attempts per item</osd:label><osd:description>Number of attempts made on each item, as comma-separated itemKey=count pairs.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Tentatives par élément</osd:label><osd:description>Nombre de tentatives faites sur chaque élément, sous forme de paires cléÉlément=nombre séparées par des virgules.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Tentativi per elemento</osd:label><osd:description>Numero di tentativi eseguiti su ciascun elemento, come coppie chiaveElemento=numero separate da virgole.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="completed" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Completed items</osd:label><osd:description>Keys of the items already processed successfully, comma-separated; they are skipped on restart.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Éléments terminés</osd:label><osd:description>Clés des éléments déjà traités avec succès, séparées par des virgules ; ils sont ignorés lors d'une reprise.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Elementi completati</osd:label><osd:description>Chiavi degli elementi già elaborati con successo, separate da virgole; vengono saltati alla ripresa.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="deadLetters" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Dead letters</osd:label><osd:description>Keys of the items abandoned after too many failed attempts, comma-separated; they are no longer retried.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Éléments rejetés</osd:label><osd:description>Clés des éléments abandonnés après trop d'échecs, séparées par des virgules ; ils ne sont plus retentés.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Elementi scartati</osd:label><osd:description>Chiavi degli elementi abbandonati dopo troppi tentativi falliti, separate da virgole; non vengono più ritentati.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="leaseOwner" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Lease owner</osd:label><osd:description>Process currently holding the lock on this run; empty when no process is running it.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Détenteur du verrou</osd:label><osd:description>Processus qui détient actuellement le verrou sur cette exécution ; vide quand aucun processus ne l'exécute.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Titolare del lock</osd:label><osd:description>Processo che detiene attualmente il lock su questa esecuzione; vuoto quando nessun processo la sta eseguendo.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="160"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="leaseExpiresAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Lease expires at</osd:label><osd:description>After this time the lock is considered abandoned and another process may take over the run.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Expiration du verrou</osd:label><osd:description>Passé ce moment, le verrou est considéré comme abandonné et un autre processus peut reprendre l'exécution.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Scadenza del lock</osd:label><osd:description>Dopo questo momento il lock è considerato abbandonato e un altro processo può riprendere l'esecuzione.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Last updated</osd:label><osd:description>Date and time the state of this run was last saved.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Dernière mise à jour</osd:label><osd:description>Date et heure du dernier enregistrement de l'état de cette exécution.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Ultimo aggiornamento</osd:label><osd:description>Data e ora dell'ultimo salvataggio dello stato di questa esecuzione.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <!-- Volume lot 7a: status/counters for connectors_run_get and the asynchronous form of
                             connectors_sync - additive to the resume-only fields above (same table, a different,
                             disjoint use - see ConnectorRepository.saveRunState). -->
                        <xs:element name="mapping" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Mapping</osd:label><osd:description>The feed mapping this run belongs to.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Mapping</osd:label><osd:description>Le mapping de flux auquel appartient cette exécution.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Mapping</osd:label><osd:description>Il mapping di flusso a cui appartiene questa esecuzione.</osd:description></xs:documentation>
                                <xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Mapping</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="status" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Status</osd:label><osd:description>RUNNING, DONE, PARTIAL, ERROR, STOPPED or INTERRUPTED (a module restart while it was RUNNING).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Statut</osd:label><osd:description>RUNNING, DONE, PARTIAL, ERROR, STOPPED ou INTERRUPTED (redémarrage du module pendant qu'elle était RUNNING).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Stato</osd:label><osd:description>RUNNING, DONE, PARTIAL, ERROR, STOPPED o INTERRUPTED (riavvio del modulo mentre era RUNNING).</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="20"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Started at</osd:label><osd:description>Date and time this run began.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Démarrée le</osd:label><osd:description>Date et heure de début de cette exécution.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Avviata il</osd:label><osd:description>Data e ora di inizio di questa esecuzione.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="createdCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Created</osd:label><osd:description>Records created so far.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Créés</osd:label><osd:description>Enregistrements créés jusqu'ici.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Creati</osd:label><osd:description>Record creati finora.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="updatedCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Updated</osd:label><osd:description>Records updated so far.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Mis à jour</osd:label><osd:description>Enregistrements mis à jour jusqu'ici.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Aggiornati</osd:label><osd:description>Record aggiornati finora.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="noChangeCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Unchanged</osd:label><osd:description>Records left unchanged so far.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Inchangés</osd:label><osd:description>Enregistrements laissés inchangés jusqu'ici.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Invariati</osd:label><osd:description>Record lasciati invariati finora.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="errorCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Errors</osd:label><osd:description>Records that failed so far.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Erreurs</osd:label><osd:description>Enregistrements en échec jusqu'ici.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Errori</osd:label><osd:description>Record falliti finora.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="skippedCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Not processed</osd:label><osd:description>Items never attempted (a truncation, circuit breaker or cancellation stopped the run early) - a nominal, non-zero count for a streamed source whose exact remainder is not knowable.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Non traités</osd:label><osd:description>Éléments jamais tentés (troncature, disjoncteur ou annulation ayant arrêté l'exécution) - un compte nominal, non nul, pour une source en flux dont le reste exact est inconnaissable.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Non elaborati</osd:label><osd:description>Elementi mai tentati (troncamento, interruttore o annullamento hanno fermato l'esecuzione) - un conteggio nominale, non nullo, per una sorgente in streaming il cui resto esatto non è conoscibile.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="rejectedCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Rejected</osd:label><osd:description>Items looked up and declined because creation is off and nothing matched.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Rejetés</osd:label><osd:description>Éléments recherchés et refusés car la création est désactivée et rien ne correspondait.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Respinti</osd:label><osd:description>Elementi cercati e rifiutati perché la creazione è disattivata e nulla corrispondeva.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="conflictCount" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Conflicts</osd:label><osd:description>Records that produced a conflict so far.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Conflits</osd:label><osd:description>Enregistrements ayant produit un conflit jusqu'ici.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Conflitti</osd:label><osd:description>Record che hanno prodotto un conflitto finora.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="truncated" type="xs:boolean" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Truncated</osd:label><osd:description>True when the source held more items than the run's maximum let it import.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Tronquée</osd:label><osd:description>Vrai quand la source contenait plus d'éléments que le maximum de l'exécution n'a permis d'importer.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Troncata</osd:label><osd:description>Vero quando la sorgente conteneva più elementi di quelli che il massimo dell'esecuzione ha permesso di importare.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="available" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Available</osd:label><osd:description>The source's real total, when known (-1 / absent otherwise).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Disponibles</osd:label><osd:description>Le total réel de la source, quand il est connu (-1 / absent sinon).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Disponibili</osd:label><osd:description>Il totale reale della sorgente, quando è noto (-1 / assente altrimenti).</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="resultsOmitted" type="xs:boolean" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Results omitted</osd:label><osd:description>True once the run has processed more items than the per-row results sample keeps.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Résultats omis</osd:label><osd:description>Vrai dès que l'exécution a traité plus d'éléments que l'échantillon de résultats détaillés n'en conserve.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Risultati omessi</osd:label><osd:description>Vero non appena l'esecuzione ha elaborato più elementi di quanti il campione di risultati ne conservi.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="firstErrors" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>First errors</osd:label><osd:description>The first failing items so far, one "key: message" line each.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Premières erreurs</osd:label><osd:description>Les premiers éléments en échec jusqu'ici, une ligne « clé : message » chacun.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Primi errori</osd:label><osd:description>I primi elementi falliti finora, una riga «chiave: messaggio» ciascuno.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="16000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="message" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Message</osd:label><osd:description>The header/notice message of the run (a "not processed" or "limit reached" notice, or the final error message).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Message</osd:label><osd:description>Le message d'en-tête ou d'avis de l'exécution (avis « non traité » ou « limite atteinte », ou le message d'erreur final).</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Messaggio</osd:label><osd:description>Il messaggio di intestazione o avviso dell'esecuzione (avviso «non elaborato» o «limite raggiunto», o il messaggio di errore finale).</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <!-- Volume lot V2-D: feed watermark of an incremental run - additive, empty for any other run. -->
                        <xs:element name="watermarkBefore" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Watermark before</osd:label><osd:description>The checkpoint an incremental feed run started from; empty on a first run.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Filigrane avant</osd:label><osd:description>Le point de reprise dont une exécution de flux incrémental est partie ; vide à la première exécution.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Filigrana prima</osd:label><osd:description>Il punto di ripresa da cui è partita l'esecuzione di un flusso incrementale; vuoto alla prima esecuzione.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="watermarkAfter" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Watermark after</osd:label><osd:description>The checkpoint an incremental feed run ended on; different from the one before only when the run ended DONE and moved it.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Filigrane après</osd:label><osd:description>Le point de reprise sur lequel une exécution de flux incrémental s'est terminée ; différent de celui d'avant seulement si l'exécution s'est terminée en DONE et l'a avancé.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Filigrana dopo</osd:label><osd:description>Il punto di ripresa su cui si è conclusa l'esecuzione di un flusso incrementale; diverso dal precedente solo se l'esecuzione è terminata in DONE e lo ha fatto avanzare.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
                        </xs:element>
                        <xs:element name="skippedByWatermark" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Skipped by watermark</osd:label><osd:description>Rows the source delivered that were at or below the checkpoint and were dropped before any lookup or transformation.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Ignorées par le filigrane</osd:label><osd:description>Lignes livrées par la source qui étaient au niveau du point de reprise ou en dessous, écartées avant toute recherche ou transformation.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="it-IT"><osd:label>Ignorate dalla filigrana</osd:label><osd:description>Righe consegnate dalla sorgente che erano al punto di ripresa o sotto, scartate prima di qualsiasi ricerca o trasformazione.</osd:description></xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="OutboundState" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Outbound deliveries</osd:label>
                            <osd:description>What was sent to the external application by each outbound mapping: fingerprint of the last document (scope &quot;changed&quot; resends only what differs), failures to replay, deletions.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Envois sortants</osd:label>
                            <osd:description>Ce qui a été envoyé à l'application externe par chaque mapping sortant : empreinte du dernier document (la portée « changed » ne renvoie que ce qui diffère), échecs à rejouer, suppressions.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/mapping /recordKey </primaryKeys>
                                <recordForm osd:class="com.on.ebx.connect.ebx.ui.OutboundStateForm"/>
                                <defaultLabel>${./recordLabel} (${./status})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="mapping" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Mapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="recordKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé de l'enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordLabel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Espace de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jeu de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SENT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Sent</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Envoyé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed (to replay)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec (à rejouer)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DELETED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Deletion sent</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Suppression envoyée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastSentAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last successful send</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier envoi réussi</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastAttemptAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last attempt</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernière tentative</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="attempts" type="xs:int" minOccurs="0" maxOccurs="1" default="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Failed attempts since the last success</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tentatives en échec depuis le dernier succès</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="hash" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Fingerprint of the sent document</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Empreinte du document envoyé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="64"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastDocument" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last document sent</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier document envoyé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="8000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastError" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last error</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernière erreur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastRunId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernière exécution</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="160"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="SyncLog" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Synchronisation log</osd:label>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Journal des synchronisations</osd:label>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <recordForm osd:class="com.on.ebx.connect.ebx.ui.SyncLogForm"/>
                                <defaultLabel>${./timestamp} ${./connector}/${./operation} ${./recordLabel} ${./status}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="timestamp" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Timestamp</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Horodatage</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="connector" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="operation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Operation</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opération</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="direction" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Direction</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Sens</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="10"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Espace de données</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé de l'enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordLabel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="20"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="changes" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Changes</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modifications</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="durationMs" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Duration (ms)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Durée (ms)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="user" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>User</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Utilisateur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>userService, workflow, scheduler, trigger, api</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>userService, workflow, scheduler, trigger, api</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="runId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Run</osd:label>
                                        <osd:description>Identifier of the execution (one REST call, workflow step, scheduled run or user service run); POST /replay/{runId} replays its failures.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exécution</osd:label>
                                        <osd:description>Identifiant de l'exécution (un appel REST, une étape de workflow, une exécution planifiée ou du service) ; POST /replay/{runId} rejoue ses échecs.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="160"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mapping" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="20"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Publication" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Product publications</osd:label><osd:description>One row per ProductPublisher.publish(...) call (dry runs included): the report of publishing a whole data product to an output port.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Publications de produits</osd:label><osd:description>Une ligne par appel à ProductPublisher.publish(...) (y compris les simulations) : le rapport de publication d'un produit de données complet vers un canal.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/runId </primaryKeys><defaultLabel>${./product} ${./contractVersion} (${./status})</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="runId" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Run</osd:label><osd:description>The Connectors run id of this publication.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Exécution</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="160"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="product" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Product</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Produit</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="contractVersion" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Contract version</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Version du contrat</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="40"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="connector" type="xs:string" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connector</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Connecteur</osd:label></xs:documentation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Connector</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
                        <xs:element name="schema" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Target schema</osd:label><osd:description>DB.SCHEMA on the target platform.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Schéma cible</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="status" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Status</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Statut</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="OK"/><xs:enumeration value="PARTIAL"/><xs:enumeration value="ERROR"/><xs:enumeration value="DRY_RUN"/><xs:maxLength value="20"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="message" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Message</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Message</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="cutoff" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Cut-off</osd:label><osd:description>The one instant every table of this publication was read as of.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Instant de référence</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Started at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Démarrée le</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="endedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Ended at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Terminée le</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="rowCount" type="xs:decimal" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Row count</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Nombre de lignes</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="mappings" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Mappings</osd:label><osd:description>Comma-separated Connectors mapping ids.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Mappings</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="tables" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Tables</osd:label><osd:description>Comma-separated TABLE=rows.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Tables</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="report" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Report</osd:label><osd:description>The full report JSON (§4), cut at 100000 characters.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Rapport</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="100000"/></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="Favorite" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Favorites</osd:label><osd:description>Per-user shortcuts pinned with the star of the connector explorer. Everybody sees only their own rows; nobody edits them by hand.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Favoris</osd:label><osd:description>Raccourcis de chaque utilisateur, épinglés avec l'étoile de l'explorateur de connecteurs. Chacun ne voit que ses lignes ; personne ne les modifie à la main.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/userLogin /targetType /targetKey </primaryKeys><defaultLabel>${./userLogin} - ${./targetType} ${./targetKey}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="userLogin" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>User</osd:label><osd:description>EBX login of the owner of the shortcut.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Utilisateur</osd:label><osd:description>Identifiant EBX du propriétaire du raccourci.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="targetType" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Kind</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Nature</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="CONNECTOR"/><xs:maxLength value="40"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="targetKey" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Target</osd:label><osd:description>Primary key of the pinned record. No foreign key: one table serves every kind, and a deleted target only leaves a dangling shortcut.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Cible</osd:label><osd:description>Clé primaire de la ligne épinglée. Sans clé étrangère : une seule table sert toutes les natures, et une cible supprimée ne laisse qu'un raccourci orphelin.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="createdAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Pinned at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Épinglé le</osd:label></xs:documentation></xs:annotation></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="SeedMarker" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Seed markers</osd:label><osd:description>What the installer created once: a seeded connector, a group of demonstration mappings, a data migration. A row here keeps the installer from creating that item again after you deleted it. Technical: delete a row only to have the installer seed that item once more at the next start.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Marqueurs d'amorçage</osd:label><osd:description>Ce que l'installeur a déjà créé une fois : un connecteur, un groupe de mappings de démonstration, une migration de données. Une ligne ici empêche l'installeur de recréer l'élément après sa suppression. Technique : ne supprimer une ligne que pour faire recréer l'élément au prochain démarrage.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/item </primaryKeys><defaultLabel>${./item}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="item" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Item</osd:label><osd:description>connector:&lt;id&gt;, mappings:&lt;group&gt;, migration:&lt;name&gt; or baseline.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Élément</osd:label><osd:description>connector:&lt;id&gt;, mappings:&lt;groupe&gt;, migration:&lt;nom&gt; ou baseline.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="seededAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Seeded at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Créé le</osd:label></xs:documentation></xs:annotation></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="OutboundQueue" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Outbound queue</osd:label><osd:description>What a table trigger asked to send to an external application, waiting for the module's background sender. A trigger never calls the external system in the user's transaction: it queues the record here and the sender sends it after the commit, at least once (the target must tolerate a repeated message). Technical: the module writes this table; a DEAD row stays until you delete it or set it back to PENDING.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>File d'envoi sortant</osd:label><osd:description>Ce qu'un déclencheur de table a demandé d'envoyer à une application externe, en attente de l'expéditeur de fond du module. Un déclencheur n'appelle jamais le système externe dans la transaction de l'utilisateur : il met l'enregistrement en file ici et l'expéditeur l'envoie après la validation, au moins une fois (la cible doit tolérer un message répété). Technique : le module écrit cette table ; une ligne DEAD reste jusqu'à sa suppression ou son retour à PENDING.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/id </primaryKeys><defaultLabel>${./recordKey} (${./status})</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="id" type="id" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Id</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Id</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="connector" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connector</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Connexion</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="operation" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Operation</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Opération</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="direction" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Direction</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Sens</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="INBOUND"/><xs:enumeration value="OUTBOUND"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="dataspace" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Dataspace</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Espace de données</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="dataset" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Dataset</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Jeu de données</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="tablePath" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Table</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Table</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="recordKey" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Record key</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Clé de l'enregistrement</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="255"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="publish" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Publish</osd:label><osd:description>golden: the trigger asked for golden records (publish=golden). At send time, a MERGED record sends its golden record instead, and a DELETED or pending record sends nothing. Empty: the record itself.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Publication</osd:label><osd:description>golden : le déclencheur a demandé les enregistrements golden (publish=golden). Au moment de l'envoi, un enregistrement MERGED envoie son golden à la place, et un enregistrement DELETED ou en attente n'envoie rien. Vide : l'enregistrement lui-même.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="golden"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="enqueuedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Queued at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Mis en file le</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="notBefore" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Not before</osd:label><osd:description>The row is not sent before this time: a few seconds after the write so that the change is committed, then the retry delay of the mapping after a failure.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Pas avant</osd:label><osd:description>La ligne n'est pas envoyée avant cet instant : quelques secondes après l'écriture pour que la modification soit validée, puis le délai de reprise du mapping après un échec.</osd:description></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="attempts" type="xs:int" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Attempts</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Tentatives</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="status" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Status</osd:label><osd:description>PENDING: waiting to be sent. DEAD: set aside after the mapping's maximum number of attempts; delete the row, or set it back to PENDING with attempts 0 to try again.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Statut</osd:label><osd:description>PENDING : en attente d'envoi. DEAD : mise à l'écart après le nombre maximal de tentatives du mapping ; supprimer la ligne, ou la remettre à PENDING avec 0 tentative pour réessayer.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="PENDING"/><xs:enumeration value="DEAD"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="lastAttemptAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Last attempt</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Dernière tentative</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="lastError" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Last error</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Dernière erreur</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="AccessRight" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Access rights</osd:label><osd:description>Who may use the connectors: one row gives a role of the directory one right on the module's MCP tools, REST routes and screens. Nobody but the EBX administrator has a right until a row (or one of the default roles ConnectorsViewer, ConnectorsOperator, ConnectorsDesigner) gives it. Only an administrator edits this table; a change applies within a few seconds.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Droits d'accès</osd:label><osd:description>Qui peut utiliser les connecteurs : une ligne donne à un rôle de l'annuaire un droit sur les outils MCP, les routes REST et les écrans du module. Personne d'autre que l'administrateur EBX n'a de droit tant qu'une ligne (ou l'un des rôles par défaut ConnectorsViewer, ConnectorsOperator, ConnectorsDesigner) ne le donne pas. Seul un administrateur modifie cette table ; un changement s'applique en quelques secondes.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/profile </primaryKeys><defaultLabel>${./profile} - ${./right}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="profile" type="xs:string" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Role</osd:label><osd:description>A role of the EBX directory. Its members receive the right of this row. "Everyone" gives the right to every authenticated user.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Rôle</osd:label><osd:description>Un rôle de l'annuaire EBX. Ses membres reçoivent le droit de cette ligne. « Tout le monde » donne le droit à tout utilisateur authentifié.</osd:description></xs:documentation>
                                <xs:appinfo>
                                    <osd:otherFacets>
                                        <osd:constraintEnumeration class="com.on.ebx.connect.ebx.ConnectorsRoleEnumeration"/>
                                    </osd:otherFacets>
                                </xs:appinfo>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="right" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Right</osd:label><osd:description>Each right includes the previous ones. Viewer: see the connections (secrets masked), the mappings, the runs and the log. Operator: also run what is configured, read the outbound documents and the conflicts, decide a conflict. Designer: also change the configuration and call any operation of a connection with its stored credentials.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Droit</osd:label><osd:description>Chaque droit inclut les précédents. Lecteur : voir les connexions (secrets masqués), les mappings, les exécutions et le journal. Opérateur : en plus, exécuter ce qui est configuré, lire les documents sortants et les conflits, trancher un conflit. Concepteur : en plus, modifier la configuration et appeler n'importe quelle opération d'une connexion avec ses identifiants stockés.</osd:description></xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="READ">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en-US">Viewer (read)</xs:documentation>
                                            <xs:documentation xml:lang="fr-FR">Lecteur (lire)</xs:documentation>
                                        </xs:annotation>
                                    </xs:enumeration>
                                    <xs:enumeration value="RUN">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en-US">Operator (read and run)</xs:documentation>
                                            <xs:documentation xml:lang="fr-FR">Opérateur (lire et exécuter)</xs:documentation>
                                        </xs:annotation>
                                    </xs:enumeration>
                                    <xs:enumeration value="MANAGE">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en-US">Designer (read, run and configure)</xs:documentation>
                                            <xs:documentation xml:lang="fr-FR">Concepteur (lire, exécuter et configurer)</xs:documentation>
                                        </xs:annotation>
                                    </xs:enumeration>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="comment" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Comment</osd:label><osd:description>Why this role has this right.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Commentaire</osd:label><osd:description>Pourquoi ce rôle a ce droit.</osd:description></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="Settings" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Settings</osd:label><osd:description>Settings of the Connectors module on this instance. Read by everyone who holds a Connectors right, changed by an EBX administrator only; a change applies at the next call, no restart.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Paramètres</osd:label><osd:description>Paramètres du module Connectors sur cette instance. Lus par toute personne ayant un droit Connectors, modifiés par un administrateur EBX uniquement ; un changement s'applique à l'appel suivant, sans redémarrage.</osd:description></xs:documentation>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="defaultLlmConnector" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation xml:lang="en-US"><osd:label>Default language-model connector</osd:label><osd:description>The language-model connection (type llm) that the other ON EBX modules (MDM Factory, data catalog) use when they ask a model without naming one. Empty: the JVM property ebx.connectors.llm.default when it is set, else the only usable language-model connection when there is exactly one; otherwise their call is refused.</osd:description></xs:documentation>
                                <xs:documentation xml:lang="fr-FR"><osd:label>Connecteur de modèle de langage par défaut</osd:label><osd:description>La connexion de modèle de langage (type llm) qu'utilisent les autres modules ON EBX (MDM Factory, catalogue de données) quand ils interrogent un modèle sans en nommer un. Vide : la propriété JVM ebx.connectors.llm.default si elle est renseignée, sinon la seule connexion de modèle de langage utilisable s'il n'y en a qu'une ; sinon leur appel est refusé.</osd:description></xs:documentation>
                                <xs:appinfo>
                                    <osd:otherFacets>
                                        <osd:tableRef>
                                            <tablePath>/root/Connector</tablePath>
                                            <filter>
                                                <predicate>./type = 'llm'</predicate>
                                                <validationMessage>
                                                    <message>Choose a connection of type llm (language model).</message>
                                                    <message xml:lang="en-US">Choose a connection of type llm (language model).</message>
                                                    <message xml:lang="fr-FR">Choisissez une connexion de type llm (modèle de langage).</message>
                                                </validationMessage>
                                            </filter>
                                        </osd:tableRef>
                                    </osd:otherFacets>
                                </xs:appinfo>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="id">
        <xs:annotation>
            <xs:appinfo>
                <osd:autoIncrement/>
            </xs:appinfo>
        </xs:annotation>
        <xs:restriction base="xs:int"/>
    </xs:simpleType>
    <xs:simpleType name="metricCounter">
        <xs:annotation><xs:documentation xml:lang="en-US">Non-negative Java 64-bit counter stored as a decimal string for EBX compatibility.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string"><xs:pattern value="[0-9]+"/><xs:maxLength value="19"/></xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="contentOwnership">
        <xs:restriction base="xs:string"><xs:enumeration value="PACKAGED"/><xs:enumeration value="CUSTOMER"/></xs:restriction>
    </xs:simpleType>
</xs:schema>
