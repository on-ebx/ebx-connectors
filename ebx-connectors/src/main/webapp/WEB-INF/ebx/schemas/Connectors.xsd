                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Read timeout (ms)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Délai de lecture (ms)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="active" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Active?</osd:label>
                                        <osd:description>An inactive mapping is never selected: neither by the service, nor by the workflow bean, nor by the REST API.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Actif ?</osd:label>
                                        <osd:description>Un mapping inactif n'est jamais sélectionné : ni par le service, ni par le bean de workflow, ni par l'API REST.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="connectionStatus" minOccurs="0" maxOccurs="1" default="NOT_CONNECTED">
                                <xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connection status</osd:label><osd:description>Persisted result of the explicit Connect action. CONNECTED never represents a retained socket.</osd:description></xs:documentation></xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="NOT_CONNECTED"/><xs:enumeration value="CONNECTED"/><xs:enumeration value="FAILED"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="connectionVerifiedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connection verified at</osd:label></xs:documentation></xs:annotation></xs:element>
                            <xs:element name="connectionFingerprint" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Verified configuration fingerprint</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="64"/></xs:restriction></xs:simpleType></xs:element>
                            <xs:element name="connectionMessage" minOccurs="0" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connection message</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction></xs:simpleType></xs:element>
                            <xs:element name="properties" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Properties</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Propriétés</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/ConnectorProperty/connector</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/key</column>
                                                <column>/value</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mappings" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/Mapping/connector</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/operation</column>
                                                <column>/direction</column>
                                                <column>/tablePath</column>
                                                <column>/active</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ConnectorProperty" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Connector properties</osd:label>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Propriétés des connecteurs</osd:label>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/connector /key </primaryKeys>
                                <defaultLabel>${./key}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="connector" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                        <osd:description>The external application or service called by this mapping (a row of the Connector table).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                        <osd:description>L'application ou le service externe appelé par ce mapping (une ligne de la table Connector).</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Connector</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="key" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Key</osd:label>
                                        <osd:description>For the rest type: op.&lt;name&gt;.method / .path / .query declare an operation.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé</osd:label>
                                        <osd:description>Pour le type rest : op.&lt;nom&gt;.method / .path / .query déclarent une opération.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="value" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Value</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ConnectorTemplate" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Connector templates</osd:label><osd:description>Versioned packaged templates and customer-owned copies. Customer copies are never replaced by packaged upgrades.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/id </primaryKeys><defaultLabel>${./id} v${./version}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="id" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="version" type="xs:int" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="ownership" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="PACKAGED"/><xs:enumeration value="CUSTOMER"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="basedOn" type="xs:string" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="basedOnVersion" type="xs:int" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="configuration" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="1000000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="createdBy" type="xs:string" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="createdAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="updatedBy" type="xs:string" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1"/>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="Release" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Releases</osd:label><osd:description>Product and customer release-note headers. Packaged installation is additive and never replaces an existing record.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/version </primaryKeys><defaultLabel>${./version} — ${./title}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="version" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="ownership" type="contentOwnership" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="releaseDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="status" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="CURRENT"/><xs:enumeration value="SUPPORTED"/><xs:enumeration value="ARCHIVED"/><xs:enumeration value="DRAFT"/><xs:enumeration value="IN_PROGRESS"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="title" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="summary" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="10000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="buildVersion" type="xs:string" minOccurs="0" maxOccurs="1"/>
                        <xs:element name="commitId" type="xs:string" minOccurs="0" maxOccurs="1"/>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ReleaseItem" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Release items</osd:label></xs:documentation><xs:appinfo><osd:table><primaryKeys>/release /id </primaryKeys><defaultLabel>${./title}</defaultLabel></osd:table></xs:appinfo></xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="release" type="xs:string" minOccurs="1" maxOccurs="1"><xs:annotation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Release</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
                        <xs:element name="id" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="ownership" type="contentOwnership" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="type" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="FEATURE"/><xs:enumeration value="FIX"/><xs:enumeration value="SECURITY"/><xs:enumeration value="UPGRADE"/><xs:enumeration value="KNOWN_ISSUE"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="displayOrder" type="xs:int" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="title" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="detail" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="10000"/></xs:restriction></xs:simpleType></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ReleaseMetric" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Release metrics</osd:label></xs:documentation><xs:appinfo><osd:table><primaryKeys>/release /code </primaryKeys><defaultLabel>${./label}: ${./value}</defaultLabel></osd:table></xs:appinfo></xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="release" type="xs:string" minOccurs="1" maxOccurs="1"><xs:annotation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Release</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
                        <xs:element name="code" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="ownership" type="contentOwnership" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="label" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="value" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="displayOrder" type="xs:int" minOccurs="1" maxOccurs="1"/>
                    </xs:sequence></xs:complexType>
                </xs:element>

                <xs:element name="ReleasePassStatus" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Release delivery status</osd:label></xs:documentation><xs:appinfo><osd:table><primaryKeys>/release /code </primaryKeys><defaultLabel>${./label}: ${./status}</defaultLabel></osd:table></xs:appinfo></xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="release" type="xs:string" minOccurs="1" maxOccurs="1"><xs:annotation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Release</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
                        <xs:element name="code" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="ownership" type="contentOwnership" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="label" type="xs:string" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="status" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="COMPLETE"/><xs:enumeration value="IN_PROGRESS"/><xs:enumeration value="BLOCKED"/><xs:enumeration value="PLANNED"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="progress" type="xs:int" minOccurs="1" maxOccurs="1"/>
                        <xs:element name="remainingGates" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="10000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="displayOrder" type="xs:int" minOccurs="1" maxOccurs="1"/>
                    </xs:sequence></xs:complexType>
                </xs:element>

				<xs:element name="ReleasePassStep" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Release pass steps</osd:label><osd:description>Immutable, ordered delivery-history entries belonging to a release pass.</osd:description></xs:documentation><xs:appinfo><osd:table><primaryKeys>/release /passCode /code </primaryKeys><defaultLabel>${./label}: ${./status}</defaultLabel></osd:table></xs:appinfo></xs:annotation>
					<xs:complexType><xs:sequence>
						<xs:element name="release" type="xs:string" minOccurs="1" maxOccurs="1"><xs:annotation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Release</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
						<xs:element name="passCode" type="xs:string" minOccurs="1" maxOccurs="1"/>
						<xs:element name="code" type="xs:string" minOccurs="1" maxOccurs="1"/>
						<xs:element name="ownership" type="contentOwnership" minOccurs="1" maxOccurs="1"/>
						<xs:element name="label" type="xs:string" minOccurs="1" maxOccurs="1"/>
						<xs:element name="status" minOccurs="1" maxOccurs="1"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="COMPLETE"/><xs:enumeration value="IN_PROGRESS"/><xs:enumeration value="BLOCKED"/><xs:enumeration value="PLANNED"/></xs:restriction></xs:simpleType></xs:element>
						<xs:element name="occurredOn" type="xs:date" minOccurs="0" maxOccurs="1"/>
						<xs:element name="detail" minOccurs="0" maxOccurs="1"><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="10000"/></xs:restriction></xs:simpleType></xs:element>
						<xs:element name="displayOrder" type="xs:int" minOccurs="1" maxOccurs="1"/>
					</xs:sequence></xs:complexType>
				</xs:element>

                <xs:element name="SchemaRefreshState" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Schema refresh state</osd:label><osd:description>Technical, restart-safe REST schema cache.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>État de rafraîchissement des schémas</osd:label><osd:description>Cache technique persistant des schémas REST.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/connector /key </primaryKeys><defaultLabel>${./connector} ${./url}</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="connector" type="xs:string" minOccurs="1" maxOccurs="1">
                            <xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Connector</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Connecteur</osd:label></xs:documentation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Connector</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation>
                        </xs:element>
                        <xs:element name="key" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>State key</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Clé d'état</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="80"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="url" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Schema URL</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>URL du schéma</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="1000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="state" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Conditional refresh state</osd:label><osd:description>Validators, timestamps and last usable schema; no credentials.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>État du rafraîchissement conditionnel</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="1000000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Updated at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Mis à jour le</osd:label></xs:documentation></xs:annotation></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="SynchronizationCheckpoint" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US"><osd:label>Synchronization checkpoints</osd:label><osd:description>Durable incremental progress, stored separately from mapping policy. A full run never clears this state.</osd:description></xs:documentation>
                        <xs:documentation xml:lang="fr-FR"><osd:label>Points de reprise de synchronisation</osd:label><osd:description>Progression incrémentale persistante, séparée de la politique du mapping.</osd:description></xs:documentation>
                        <xs:appinfo><osd:table><primaryKeys>/mapping </primaryKeys><recordForm osd:class="com.on.ebx.connect.ebx.ui.CheckpointForm"/><defaultLabel>${./mapping} (${./strategy})</defaultLabel></osd:table></xs:appinfo>
                    </xs:annotation>
                    <xs:complexType><xs:sequence>
                        <xs:element name="mapping" type="xs:string" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Mapping</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Mapping</osd:label></xs:documentation><xs:appinfo><osd:otherFacets><osd:tableRef><tablePath>/root/Mapping</tablePath></osd:tableRef></osd:otherFacets></xs:appinfo></xs:annotation></xs:element>
                        <xs:element name="strategy" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Strategy</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Stratégie</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="TIMESTAMP"/><xs:enumeration value="MONOTONIC_ID"/><xs:enumeration value="ORDERED_STRING"/><xs:enumeration value="VENDOR_CURSOR"/><xs:enumeration value="ODATA_DELTA"/><xs:enumeration value="EBX_DELTA"/><xs:enumeration value="SNAPSHOT"/><xs:maxLength value="40"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="value" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Checkpoint value</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Valeur du point de reprise</osd:label></xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="1000000"/></xs:restriction></xs:simpleType></xs:element>
                        <xs:element name="updatedAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Updated at</osd:label></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Mis à jour le</osd:label></xs:documentation></xs:annotation></xs:element>
                        <xs:element name="version" type="xs:int" minOccurs="1" maxOccurs="1" default="1"><xs:annotation><xs:documentation xml:lang="en-US"><osd:label>Version</osd:label><osd:description>Optimistic concurrency token.</osd:description></xs:documentation><xs:documentation xml:lang="fr-FR"><osd:label>Version</osd:label></xs:documentation></xs:annotation></xs:element>
                    </xs:sequence></xs:complexType>
                </xs:element>
                <xs:element name="Mapping" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Mappings</osd:label>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Mappings</osd:label>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <recordForm osd:class="com.on.ebx.connect.ebx.ui.MappingForm"/>
                                <defaultLabel>${./label} [${./connector} / ${./operation} ${./direction}]</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                            <osd:trigger class="com.on.ebx.connect.ebx.trigger.MappingCascadeTrigger">
                                <enabled>true</enabled>
                            </osd:trigger>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="connector" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Connector</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="operation" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Operation</osd:label>
                                        <osd:description>What the connector is asked to do: one of the operations it offers (read: fetch a document for the record, e.g. GLEIF lei; search: find records, e.g. GLEIF searchByName; write: send the document built from the record, e.g. Salesforce upsert). Its inputs are set in the Inputs tab or in the designer, its result is mapped by the rules.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opération</osd:label>
                                        <osd:description>Ce que le connecteur doit faire : une des opérations qu'il propose (lecture : rapporter un document pour l'enregistrement, ex. GLEIF lei ; recherche : trouver des enregistrements, ex. GLEIF searchByName ; écriture : envoyer le document construit depuis l'enregistrement, ex. Salesforce upsert). Ses entrées se définissent dans l'onglet Entrées ou dans le concepteur, son résultat est traduit par les règles.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:constraintEnumeration class="com.on.ebx.connect.ebx.MappingOperationEnumeration"/>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="direction" minOccurs="0" maxOccurs="1" default="INBOUND">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Direction</osd:label>
                                        <osd:description>Inbound: the document returned by the operation is written into the EBX record (rules source = JSON path, target = EBX field). Outbound: a document is built from the record and sent (rules source = EBX field, target = JSON path); the answer can be stored through a twin inbound mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Sens</osd:label>
                                        <osd:description>Entrant : le document rendu par l'opération est écrit dans l'enregistrement EBX (règles : source = chemin JSON, cible = champ EBX). Sortant : un document est construit depuis l'enregistrement et envoyé (règles : source = champ EBX, cible = chemin JSON) ; la réponse peut être stockée par un mapping entrant jumeau.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="INBOUND">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Inbound (external system to EBX)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Entrant (système externe vers EBX)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="OUTBOUND">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Outbound (EBX to external system)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Sortant (EBX vers système externe)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Libellé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="description" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Description</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Description</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataspace" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                        <osd:description>Empty: any dataspace holding the dataset (workflow child dataspaces included).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Espace de données</osd:label>
                                        <osd:description>Vide : tout espace de données portant le dataset (espaces enfants de workflow compris).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="dataset" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataset</osd:label>
                                        <osd:description>Name of the EBX dataset holding the table (e.g. Companies).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jeu de données</osd:label>
                                        <osd:description>Nom du jeu de données EBX qui porte la table (ex. Companies).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table path</osd:label>
                                        <osd:description>e.g. /root/Companies</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin de la table</osd:label>
                                        <osd:description>ex. /root/Companies</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:constraint class="com.on.ebx.connect.ebx.MappingTableConstraint"/>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="responseRoot" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Response root (JSON path)</osd:label>
                                        <osd:description>Applied to the document before the rules, e.g. data.attributes</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Racine de la réponse (chemin JSON)</osd:label>
                                        <osd:description>Appliquée au document avant les règles, ex. data.attributes</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="active" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Active?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Actif ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="parent" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Parent mapping</osd:label>
                                        <osd:description>Set on a sub-object mapping (addresses, contacts...): this mapping then describes one element of a collection of the parent document.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping parent</osd:label>
                                        <osd:description>Renseigné sur un mapping de sous-objet (adresses, contacts...) : ce mapping décrit alors un élément d'une collection du document parent.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Mapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="collectionPath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Collection path (JSON)</osd:label>
                                        <osd:description>Sub-object mappings: JSON path of the array in the parent document, e.g. addresses. Inbound: read; outbound: built.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin de la collection (JSON)</osd:label>
                                        <osd:description>Mappings de sous-objet : chemin JSON du tableau dans le document parent, ex. addresses. Entrant : lu ; sortant : construit.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="parentLinkField" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Parent link field</osd:label>
                                        <osd:description>Sub-object mappings: foreign key of the child table pointing to the parent record, e.g. ./company</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ de lien vers le parent</osd:label>
                                        <osd:description>Mappings de sous-objet : clé étrangère de la table fille vers le parent, ex. ./company</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="childKeyFields" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Child key fields</osd:label>
                                        <osd:description>Comma-separated child fields identifying an existing row for updates, e.g. ./type,./City. Empty: always create.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champs d'identification de l'enfant</osd:label>
                                        <osd:description>Champs de la table fille, séparés par des virgules, identifiant une ligne existante à mettre à jour, ex. ./type,./City. Vide : toujours créer.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="childFilter" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Child filter (XPath)</osd:label>
                                        <osd:description>Predicate restricting the child rows handled, e.g. ./source='GLEIF'</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Filtre des enfants (XPath)</osd:label>
                                        <osd:description>Prédicat restreignant les lignes filles traitées, ex. ./source='GLEIF'</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="deleteMissing" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Delete children absent from the document?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Supprimer les enfants absents du document ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="itemsPath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Items path (imports)</osd:label>
                                        <osd:description>Feed mappings (Kafka, SOQL query...): JSON path of the array of items in the connector document, e.g. messages[*].value or records. Empty: the document is one item.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin des éléments (imports)</osd:label>
                                        <osd:description>Mappings de flux (Kafka, requête SOQL...) : chemin JSON du tableau d'éléments dans le document du connecteur, ex. messages[*].value ou records. Vide : le document est un élément.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="keyPredicate" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key predicate (imports)</osd:label>
                                        <osd:description>XPath predicate locating the target record, with ${json.path} placeholders resolved from the item, e.g. ./Identification/LegalEntityIdentifier='${lei}'. Makes the mapping an import feed.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prédicat de clé de l'enregistrement (imports)</osd:label>
                                        <osd:description>Prédicat XPath localisant l'enregistrement cible, avec des ${chemin.json} résolus depuis l'élément, ex. ./Identification/LegalEntityIdentifier='${lei}'. Fait du mapping un flux d'import.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="createIfMissing" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Create the record when not found (imports)?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Créer l'enregistrement s'il n'existe pas (imports) ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="loadMode" minOccurs="0" maxOccurs="1" default="FULL">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Load mode</osd:label><osd:description>FULL requests the complete source. INCREMENTAL uses the selected checkpoint policy; runtime checkpoint values are stored separately.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Mode de chargement</osd:label><osd:description>FULL demande la source complète. INCREMENTAL utilise la politique de point de reprise ; les valeurs d'exécution sont stockées séparément.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="FULL"/><xs:enumeration value="INCREMENTAL"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="checkpointStrategy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Checkpoint strategy</osd:label><osd:description>How an incremental position is interpreted: source timestamp, increasing identifier, ordered string, vendor cursor, OData delta link, EBX delta, or snapshot fingerprint. On an import feed, TIMESTAMP, MONOTONIC_ID (a number) and ORDERED_STRING (plain string order) make a row watermark: the highest value of the checkpoint value path seen by a run that ends DONE.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Stratégie de point de reprise</osd:label><osd:description>Interprétation de la position incrémentale : horodatage, identifiant croissant, chaîne ordonnée, curseur fournisseur, delta OData, delta EBX ou empreinte de snapshot. Sur un flux d'import, TIMESTAMP, MONOTONIC_ID (un nombre) et ORDERED_STRING (ordre alphabétique simple) forment un filigrane de ligne : la plus grande valeur du chemin de valeur lue par une exécution terminée en DONE.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="TIMESTAMP"/><xs:enumeration value="MONOTONIC_ID"/><xs:enumeration value="ORDERED_STRING"/><xs:enumeration value="VENDOR_CURSOR"/><xs:enumeration value="ODATA_DELTA"/><xs:enumeration value="EBX_DELTA"/><xs:enumeration value="SNAPSHOT"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="checkpointInput" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Checkpoint input</osd:label><osd:description>Connector input receiving the last checkpoint, for example since, after, cursor or deltaLink.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Entrée du point de reprise</osd:label><osd:description>Entrée du connecteur recevant le dernier point de reprise, par exemple since, after, cursor ou deltaLink.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="checkpointValuePath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Checkpoint value path</osd:label><osd:description>JSON path or source field from which the next timestamp, id, cursor, delta link or snapshot value is derived. On an import feed with a row-watermark strategy: the field of each returned row that carries the change value, e.g. LAST_MODIFIED.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Chemin de la valeur du point de reprise</osd:label><osd:description>Chemin JSON ou champ source fournissant le prochain horodatage, identifiant, curseur, lien delta ou snapshot. Sur un flux d'import avec une stratégie de filigrane de ligne : le champ de chaque ligne retournée qui porte la valeur de changement, par ex. LAST_MODIFIED.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="checkpointInitialValue" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Initial checkpoint value</osd:label><osd:description>Optional bootstrap value used before a runtime checkpoint exists. This is configuration, not mutable checkpoint state.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Valeur initiale du point de reprise</osd:label><osd:description>Valeur d'amorçage facultative avant l'existence d'un point de reprise d'exécution. Il s'agit de configuration, pas d'état mutable.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="osd:text"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="checkpointBoundary" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US"><osd:label>Watermark boundary</osd:label><osd:description>For import feeds with a row watermark only: whether a row whose watermark EQUALS the saved checkpoint is read again at the next run. INCLUSIVE is the safe choice (a row committed at the source after the previous read, with that very value, is not lost) and needs "Skip when unchanged" so that the rows read again report NO_CHANGE without a write; EXCLUSIVE skips them. Empty: INCLUSIVE when "Skip when unchanged" is set, EXCLUSIVE otherwise.</osd:description></xs:documentation>
                                    <xs:documentation xml:lang="fr-FR"><osd:label>Borne du filigrane</osd:label><osd:description>Pour les flux d'import avec filigrane de ligne uniquement : une ligne dont le filigrane est ÉGAL au point de reprise enregistré est-elle relue à l'exécution suivante. INCLUSIVE est le choix sûr (une ligne validée à la source après la lecture précédente, avec cette valeur exacte, n'est pas perdue) et demande « Ignorer si inchangé » pour que les lignes relues soient rapportées NO_CHANGE sans écriture ; EXCLUSIVE les ignore. Vide : INCLUSIVE si « Ignorer si inchangé » est renseigné, EXCLUSIVE sinon.</osd:description></xs:documentation>
                                </xs:annotation>
                                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="INCLUSIVE"/><xs:enumeration value="EXCLUSIVE"/></xs:restriction></xs:simpleType>
                            </xs:element>
                            <xs:element name="deleteOperation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Delete operation (outbound)</osd:label>
                                        <osd:description>Operation of the connector called for the records deleted since the last send (scope changed) or since the initial snapshot (scope dataspaceDelta); empty: deletions are not propagated.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opération de suppression (sortant)</osd:label>
                                        <osd:description>Opération du connecteur appelée pour les enregistrements supprimés depuis le dernier envoi (portée changed) ou depuis le snapshot initial (portée dataspaceDelta) ; vide : les suppressions ne sont pas propagées.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="maxAttempts" type="xs:int" minOccurs="0" maxOccurs="1" default="5">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Maximum attempts (outbound)</osd:label>
                                        <osd:description>After this number of failed sends a record stays FAILED until a manual replay.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nombre maximal de tentatives (sortant)</osd:label>
                                        <osd:description>Au-delà de ce nombre d'envois en échec, l'enregistrement reste FAILED jusqu'à un rejeu manuel.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="retryDelayMinutes" type="xs:int" minOccurs="0" maxOccurs="1" default="30">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Delay between attempts, minutes (outbound)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Délai entre deux tentatives, minutes (sortant)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="provenance" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record field provenance?</osd:label>
                                        <osd:description>Off for a feed whose target table already carries its own lineage (e.g. a landing table with _loadId/_sourceSystem): skips FieldProvenance bookkeeping entirely, the dominant per-row cost of a high-volume feed.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrer la provenance des champs ?</osd:label>
                                        <osd:description>Désactiver pour un flux dont la table cible porte déjà sa propre traçabilité (ex. une table de landing avec _loadId/_sourceSystem) : n'écrit alors aucune ligne FieldProvenance, le coût dominant par ligne d'un flux à fort volume.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="unchangedIfEqual" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Skip when unchanged (target field)</osd:label>
                                        <osd:description>Path of a field of the TARGET table (e.g. ./_rowHash). When set and the record already exists, an import feed compares the mapped value for this field against the record's current value before writing anything; an exact match reports the row NO_CHANGE and skips the write entirely, ALWAYS-policy rules on technical fields (_loadId, _receivedAt...) included. Empty: the check is off.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Ignorer si inchangé (champ cible)</osd:label>
                                        <osd:description>Chemin d'un champ de la table CIBLE (ex. ./_rowHash). Si renseigné et que l'enregistrement existe déjà, un flux d'import compare la valeur calculée pour ce champ à la valeur actuelle de l'enregistrement avant toute écriture ; une égalité exacte rapporte la ligne NO_CHANGE et n'écrit rien, règles à politique ALWAYS sur des champs techniques (_loadId, _receivedAt...) comprises. Vide : la vérification est désactivée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="batchSize" type="xs:int" minOccurs="0" maxOccurs="1" default="1000">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Import batch size</osd:label>
                                        <osd:description>Number of rows an import feed writes together when it really runs. The rows are looked up and mapped first, then written in batches of this size, one transaction per batch; a batch that fails is split until the row at fault is isolated. A larger batch is faster. Set 1 to write row by row (one transaction per row, slower). Default 1000, maximum 10000. Ignored by a simulation and by outbound synchronisation.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Taille de lot d'import</osd:label>
                                        <osd:description>Nombre de lignes qu'un flux d'import écrit ensemble lorsqu'il s'exécute pour de bon. Les lignes sont d'abord recherchées et mappées, puis écrites par lots de cette taille, une transaction par lot ; un lot en échec est scindé jusqu'à isoler la ligne en cause. Un lot plus grand est plus rapide. Mettre 1 pour écrire ligne par ligne (une transaction par ligne, plus lent). Défaut 1000, maximum 10000. Ignoré en simulation et en synchronisation sortante.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="logEveryRecord" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Log every record?</osd:label>
                                        <osd:description>Off (default): the synchronisation log gets one line per import batch (counts, first and last record key), plus one line for each record in error or in conflict. On: one line per imported record, including those created, updated or unchanged. Turn it on only when a feed needs per-record lines, as it multiplies the size of the log by the number of rows.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Journaliser chaque enregistrement ?</osd:label>
                                        <osd:description>Désactivé (défaut) : le journal de synchronisation reçoit une ligne par lot importé (compteurs, première et dernière clé) plus une ligne par enregistrement en erreur ou en conflit. Activé : une ligne par enregistrement importé, y compris les créés, modifiés ou inchangés. À n'activer que si un flux a besoin de lignes par enregistrement : le journal grossit autant que le nombre de lignes lues.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="inputs" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Inputs</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entrées</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/MappingInput/mapping</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/name</column>
                                                <column>/expression</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="children" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Sub-object mappings</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mappings de sous-objets</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/Mapping/parent</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/label</column>
                                                <column>/collectionPath</column>
                                                <column>/tablePath</column>
                                                <column>/active</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rules" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rules</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Règles</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/MappingRule/mapping</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/position</column>
                                                <column>/sourcePath</column>
                                                <column>/targetPath</column>
                                                <column>/transformation</column>
                                                <column>/policy</column>
                                                <column>/active</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="MappingInput" minOccurs="0" maxOccurs="unbounded">
