                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Mapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="position" type="xs:int" minOccurs="0" maxOccurs="1" default="10">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Position</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Position</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourcePath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source path</osd:label>
                                        <osd:description>Inbound: JSON path (entity.legalName.name, bic[0], addressLines[*]). Outbound: record path (./Group/field).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin source</osd:label>
                                        <osd:description>Entrant : chemin JSON (entity.legalName.name, bic[0], addressLines[*]). Sortant : chemin du record (./Groupe/champ).</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:constraint class="com.on.ebx.connect.ebx.MappingRulePathConstraint"/>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetPath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target path</osd:label>
                                        <osd:description>Inbound: record path (./LegalInformation/legalName). Outbound: JSON path.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin cible</osd:label>
                                        <osd:description>Entrant : chemin du record (./LegalInformation/legalName). Sortant : chemin JSON.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:constraint class="com.on.ebx.connect.ebx.MappingRulePathConstraint"/>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="transformation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transformation</osd:label>
                                        <osd:description>Pipeline: trim|left(255), isoDate, map(A=B;C=D;*=X), fk(/root/ReferenceData/LegalForm), join(, ), constant(x), default(x), regex(p,g), date(in,out)...</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Transformation</osd:label>
                                        <osd:description>Pipeline : trim|left(255), isoDate, map(A=B;C=D;*=X), fk(/root/ReferenceData/LegalForm), join(, ), constant(x), default(x), regex(p,g), date(in,out)...</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="policy" minOccurs="0" maxOccurs="1" default="IF_EMPTY">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Write policy</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Politique d'écriture</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="IF_EMPTY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Only when the field is empty</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Seulement si le champ est vide</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ALWAYS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Always (overwrite)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Toujours (écrase)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TRUSTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Trusted (write when empty, or when this source is at least as trusted as the one that wrote the value; otherwise log a conflict)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Selon la confiance (écrire si vide, ou si cette source est au moins aussi fiable que celle qui a écrit la valeur ; sinon consigner un conflit)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
