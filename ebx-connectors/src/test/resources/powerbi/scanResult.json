          "name": "Finance model",
          "configuredBy": "finance-bi@corp.example",
          "contentProviderType": "PbixInImportMode",
          "description": "Semantic model of the revenue reporting",
          "expressions": [
            { "name": "SnowflakeServer", "expression": "\"xy12345.snowflakecomputing.com\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]" }
          ],
          "upstreamDataflows": [ { "targetDataflowId": "ffffffff-0001-0000-0000-000000000001", "groupId": "11111111-1111-1111-1111-111111111111" } ],
          "datasourceUsages": [ { "datasourceInstanceId": "ds-snowflake" }, { "datasourceInstanceId": "ds-sqlserver" } ],
          "tables": [
            {
              "name": "Orders",
              "description": "Sales orders",
              "source": [ { "expression": "let\n    Source = Snowflake.Databases(SnowflakeServer, \"COMPUTE_WH\"),\n    ANALYTICS_Database = Source{[Name=\"ANALYTICS\", Kind=\"Database\"]}[Data],\n    SALES_Schema = ANALYTICS_Database{[Name=\"SALES\", Kind=\"Schema\"]}[Data],\n    ORDERS_Table = SALES_Schema{[Name=\"ORDERS\", Kind=\"Table\"]}[Data],\n    #\"Renamed Columns\" = Table.RenameColumns(ORDERS_Table, {{\"ORDER_ID\", \"Order id\"}, {\"ORDER_DATE\", \"Order date\"}, {\"GROSS_PRICE\", \"Gross price\"}, {\"DISCOUNT\", \"Discount\"}}),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns\", {{\"Order date\", type date}})\nin\n    #\"Changed Type\"" } ],
              "columns": [
                { "name": "Order id", "dataType": "Int64", "isHidden": false, "columnType": "Data" },
                { "name": "Order date", "dataType": "DateTime", "isHidden": false, "columnType": "Data" },
                { "name": "Gross price", "dataType": "Decimal", "isHidden": false, "columnType": "Data" },
                { "name": "Discount", "dataType": "Decimal", "isHidden": false, "columnType": "Data" },
                { "name": "Net revenue", "dataType": "Decimal", "isHidden": false, "columnType": "Calculated", "expression": "Orders[Gross price] - Orders[Discount]" },
                { "name": "Internal key", "dataType": "String", "isHidden": true, "columnType": "Data" }
              ],
              "measures": [
                { "name": "Total revenue", "expression": "SUM(Orders[Net revenue])", "description": "Net revenue, all orders" },
                { "name": "Total discount", "expression": "SUM ( Orders[Discount] )" },
                { "name": "Discount rate", "expression": "// share of the discount\nDIVIDE([Total discount], [Total revenue] + [Total discount])" }
              ]
            },
            {
              "name": "Customer",
              "source": [ { "expression": "let\n    Source = Sql.Database(\"sqlsrv.corp.example\", \"CRM\"),\n    dbo_Customer = Source{[Schema=\"dbo\",Item=\"Customer\"]}[Data],\n    #\"Filtered Rows\" = Table.SelectRows(dbo_Customer, each [Active] = true),\n    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows\", {\"Active\"})\nin\n    #\"Removed Columns\"" } ],
              "columns": [
                { "name": "Id", "dataType": "Int64", "columnType": "Data" },
                { "name": "Name", "dataType": "String", "columnType": "Data" },
                { "name": "Country", "dataType": "String", "columnType": "Data" }
              ],
              "measures": []
            },
            {
              "name": "Date",
              "source": [ { "expression": "let\n    Source = List.Dates(#date(2020, 1, 1), 3653, #duration(1, 0, 0, 0)),\n    #\"Converted to Table\" = Table.FromList(Source, Splitter.SplitByNothing(), {\"Date\"})\nin\n    #\"Converted to Table\"" } ],
              "columns": [ { "name": "Date", "dataType": "DateTime", "columnType": "Data" } ],
              "measures": []
            }
          ]
        }
      ],
